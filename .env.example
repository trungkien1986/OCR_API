# Copy thành .env, KHÔNG commit .env thật vào git

REDIS_URL=redis://redis:6379/0
STORAGE_DIR=/data/storage
MAX_UPLOAD_MB=25

# Postgres
POSTGRES_USER=ocr
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=ocr_engine
DATABASE_URL=postgresql+psycopg://ocr:change-me-strong@postgres:5432/ocr_engine

# Khoá mã hoá tenant_secret lúc lưu trữ (Fernet) — KHÔNG mất khoá này, mất là
# mọi tenant_secret đã cấp không thể khôi phục, phải cấp lại cho toàn bộ tenant.
# Sinh bằng: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=
